SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database

FILESYSTEM_DISK=public

MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=netspringbusiness@gmail.com
MAIL_PASSWORD=                    # Mot de passe App Gmail
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=netspringbusiness@gmail.com
MAIL_FROM_NAME=NETSPRING

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

GENIUSPAY_API_KEY=<votre-cle-publique-live>
GENIUSPAY_API_SECRET=<votre-cle-secrete-live>
