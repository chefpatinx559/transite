APP_NAME=NETSPRING
APP_ENV=production
APP_DEBUG=false
APP_KEY=                          # php artisan key:generate --show
APP_URL=https://ton-domaine.ci

DB_CONNECTION=mysql
DB_HOST=${{MySQL.MYSQL_HOST}}
DB_PORT=${{MySQL.MYSQL_PORT}}
DB_DATABASE=${{MySQL.MYSQL_DATABASE}}
